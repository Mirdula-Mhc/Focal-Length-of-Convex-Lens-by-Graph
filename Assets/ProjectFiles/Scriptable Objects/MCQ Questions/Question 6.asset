  m_Script: {fileID: 11500000, guid: d01fd2d64a9249049aaa77d5c12a82fe, type: 3}
  m_Name: Question 6
  m_EditorClassIdentifier: 
  questionText: '8. A converging lens of refractive index 1.5 is kept

    in a liquid
    medium having the same refractive

    index. What would be the focal length
    of the lens in this medium?'
  referenceImage: {fileID: 0}
  explanationText: "We have lens maker's formula, 1 = (2 - 1)(R1R2)\nHere, #1=/42=1.5\n\uAD6C=0\nf\nf=oo"
  options:
  - 1
  - 0
  - infinity
  - None of the above
  correctOptionIndex: 2
